# Copy to .env.local and replace the demo values below with real ones.
# .env.local is git-ignored and must never be committed.
#
# The values here are DEMO PLACEHOLDERS. They have the right shape so the app
# starts and the wiring is obvious, but they are not valid credentials: with
# them in place the forms validate normally and then return a localised
# "temporarily unavailable" error while the server logs the failure. Replace
# all three GOOGLE_* values to store submissions for real. See the "Google
# Sheets setup" section of the README.

# --- Google Sheets (service account) ------------------------------------

# From the service-account JSON key, field "client_email".
GOOGLE_SERVICE_ACCOUNT_EMAIL=conferences-demo@scienceipu-demo.iam.gserviceaccount.com

# From the same JSON key, field "private_key". Keep it on one line inside
# double quotes and leave the \n escapes exactly as they appear there; the app
# unescapes them. The key below is a demo string, not a real key.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEY0\nDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEY1\nDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEYDEMOKEY2\n-----END PRIVATE KEY-----\n"

# The id in the spreadsheet URL between /d/ and /edit.
GOOGLE_SHEET_ID=1DemoSheetIdReplaceMeWithTheRealOneFromTheUrl

# Tab that receives registrations. The Newsletter and Contacts tab names are
# fixed in the code.
GOOGLE_SHEET_TAB=Registrations

# --- Site ---------------------------------------------------------------

# Absolute origin used for canonical URLs, hreflang alternates and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
