# Copy to .env.local and fill in. .env.local is git-ignored and must never be
# committed. The app builds and runs without these; the forms then return a
# localised "temporarily unavailable" error and log a warning on the server.

# --- Google Sheets (service account) ------------------------------------
# Service account address, e.g. conferences-writer@my-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The full private key from the downloaded JSON key file, including the
# BEGIN/END lines. Keep it on one line wrapped in double quotes and leave the
# \n escapes exactly as they appear in the JSON; the app unescapes them.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# The id from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# Tab names. Only the registrations tab is configurable; the other two are
# fixed so the API routes stay predictable.
GOOGLE_SHEET_TAB=Registrations

# --- Site ---------------------------------------------------------------
# Absolute origin used for canonical URLs, hreflang alternates and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
