# Copy to .env.local and adjust for your environment.
# .env.local is git-ignored and must never be committed.

# --- ipu-back backend ----------------------------------------------------

# Base URL of the ipu-back USER app (public form submissions). Server-side
# only: the Next.js API routes proxy form posts to it, so it can live on a
# private network. Collections: conference_registrations, conference_contacts,
# conference_newsletter_subscriptions, conference_uploads.
# Production: https://ipuuser.educon.uz (Swagger: /docs). Local dev: http://localhost:4000
CONFERENCE_API_URL=https://ipuuser.educon.uz

# Base URL of the ipu-back ADMIN app (JWT auth + protected list endpoints).
# Exposed to the browser: the /admin panel calls it directly and logs in via
# its POST /auth/login.
# Production: https://ipuadmin.educon.uz (Swagger: /docs). Local dev: http://localhost:3000
NEXT_PUBLIC_ADMIN_API_URL=https://ipuadmin.educon.uz

# --- Site ---------------------------------------------------------------

# Absolute origin used for canonical URLs, hreflang alternates and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
